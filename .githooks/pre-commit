#!/bin/sh
#
# Pre-commit-vagt: naegter commits med hemmeligheder i.
#
# HVORFOR: en noegle, der foerst er committet, ligger i historikken for altid.
# At fjerne den kraever historik-omskrivning OG rotation af noeglen. Det er
# 100 gange nemmere at stoppe den her. (Baggrund: .env-eksponeringen 22/7-26.)
#
# Vagten gaelder ALLE haender, inkl. Claude Code.
#
# INSTALLATION PAA NY MASKINE (hook'en virker ikke af sig selv):
#   1) winget install Gitleaks.Gitleaks
#   2) git config core.hooksPath .githooks
#   3) test: commit en fake noegle og se den blive afvist
#
# Filen SKAL have LF-linjeskift og ren ASCII. CRLF faar Git for Windows'
# indbyggede sh til at fejle med en kryptisk besked. Se .gitattributes.

set -u

# Fail-closed: er vaerktoejet ikke der, gaar der ingen commits igennem.
# Hellere en blokeret commit end en falsk tryghed - hvis hook'en stiltiende
# lod commits passere, naar gitleaks manglede, ville vagten vaere vaerdiloes
# praecis paa den maskine, hvor den ikke er sat op.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "STOP: gitleaks er ikke installeret - commit afvist."
  echo "Installer med:  winget install Gitleaks.Gitleaks"
  echo "og saet saa:    git config core.hooksPath .githooks"
  echo ""
  exit 1
fi

CONFIG=""
if [ -f .gitleaks.toml ]; then
  CONFIG="--config .gitleaks.toml"
fi

# --staged      : scan KUN det, der er lagt til commit (ikke hele historikken)
# --pre-commit  : hoerer sammen med --staged; begge skal med
# --redact      : skjul selve fundet i outputtet - ellers staar hemmeligheden
#                 i din terminal og i dit scrollback
gitleaks git --pre-commit --staged --redact --verbose $CONFIG
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "COMMIT AFVIST: gitleaks fandt noget, der ligner en hemmelighed."
  echo ""
  echo "Saadan gaar du videre:"
  echo "  1) Er det en aegte noegle? Fjern den fra filen. Hoerer den til i"
  echo "     .env-filen, saa tjek at .env staar i .gitignore."
  echo "  2) Er det en falsk alarm? Tilfoej en undtagelse i .gitleaks.toml"
  echo "     - og skriv HVORFOR i en kommentar ved siden af."
  echo ""
  echo "Kan du ikke komme videre, saa STOP og faa hjaelp. Brug ikke"
  echo "--no-verify for at komme uden om: det er praecis den vane, der"
  echo "gjorde vagten noedvendig."
  echo ""
  exit 1
fi

# -----------------------------------------------------------------------------
# S17: tilbud/ er en OFFENTLIG mappe
#
# server.js serverer hele mappen paa /tilbud med express.static. Alt, der
# lander her, kan hentes af enhver, der gaetter filnavnet - ingen login,
# ingen token, ingen RLS.
#
# Reglen staar i tilbud/README.md. DETTE er vagten, der haandhaever den.
# S17 formulerer selv hvorfor begge dele skal findes:
#   "et vaern frem for en hukommelsesregel - reglen svigter, naar man er traet."
#
# Falsk alarm? Skriv filens sti i .s17-undtagelser (en pr. linje) MED en
# kommentar om hvorfor - samme moenster som .gitleaks.toml.
# -----------------------------------------------------------------------------

S17_MOENSTER='process\.env|require\(|prompt'
S17_UNDTAG=".s17-undtagelser"
S17_TMP=".git/s17-liste-$$"

git diff --cached --name-only --diff-filter=ACM -- 'tilbud/*' > "$S17_TMP" 2>/dev/null
S17_FEJL=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  [ "$f" = "tilbud/README.md" ] && continue
  if [ -f "$S17_UNDTAG" ] && grep -qxF "$f" "$S17_UNDTAG" 2>/dev/null; then
    continue
  fi
  if git show ":$f" 2>/dev/null | grep -qE "$S17_MOENSTER"; then
    if [ "$S17_FEJL" -eq 0 ]; then
      echo ""
      echo "COMMIT AFVIST: tilbud/ er en OFFENTLIG mappe."
      echo ""
    fi
    S17_FEJL=1
    echo "  $f"
    git show ":$f" 2>/dev/null | grep -nE "$S17_MOENSTER" | head -3 | sed 's/^/      linje /'
  fi
done < "$S17_TMP"

rm -f "$S17_TMP"

if [ "$S17_FEJL" -ne 0 ]; then
  echo ""
  echo "Filerne ovenfor ligger i tilbud/ og indeholder process.env, require("
  echo "eller ordet prompt. De serveres direkte paa /tilbud."
  echo ""
  echo "Saadan gaar du videre:"
  echo "  1) Er det serverkode, en promptskabelon, prislogik eller kvotelogik?"
  echo "     Flyt filen UD af tilbud/ og hent den gennem et endpoint."
  echo "  2) Er det klient-JS, hvor ordet indgaar uskyldigt?"
  echo "     Omdoeb variablen - eller skriv stien i .s17-undtagelser"
  echo "     med en kommentar om HVORFOR."
  echo ""
  echo "Brug ikke --no-verify. Det er den vane, vagten findes imod."
  echo "Se tilbud/README.md og S17 i docs/RISIKOREGISTER.md."
  echo ""
  exit 1
fi

exit 0
